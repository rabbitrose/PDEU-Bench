{
  "api_name": "research.retrieve_dataset",
  "category": "research",
  "action": "retrieve_dataset",
  "description": "Retrieve structured datasets by topic, geography, date range, and licensing constraints.",
  "interface": {
    "type": "function_call",
    "function": "research.retrieve_dataset",
    "version": "1.0",
    "input_format": "json_object",
    "output_format": "json_object",
    "parameters": [
      {
        "name": "topic",
        "type": "string",
        "required": true,
        "description": "Dataset topic.",
        "preference_sensitive": false
      },
      {
        "name": "geography",
        "type": "string",
        "required": true,
        "description": "Geographic scope.",
        "preference_sensitive": false
      },
      {
        "name": "date_range",
        "type": "object",
        "required": true,
        "description": "Temporal coverage.",
        "preference_sensitive": false
      },
      {
        "name": "format_preference",
        "type": "string",
        "required": true,
        "description": "CSV, JSON, spreadsheet, API, or database.",
        "preference_sensitive": false
      },
      {
        "name": "license_constraints",
        "type": "array[string]",
        "required": true,
        "description": "Acceptable licenses.",
        "preference_sensitive": false
      },
      {
        "name": "quality_threshold",
        "type": "string",
        "required": true,
        "description": "Data quality standard.",
        "preference_sensitive": false
      },
      {
        "name": "privacy_constraints",
        "type": "array[string]",
        "required": false,
        "description": "Privacy or sensitivity constraints.",
        "preference_sensitive": true
      }
    ],
    "returns": {
      "datasets": "array",
      "recommended_dataset": "object",
      "license_notes": "array"
    },
    "preference_sensitive_parameters": [
      "privacy_constraints"
    ],
    "preference_sensitive_parameter_details": [
      {
        "name": "privacy_constraints",
        "type": "array[string]",
        "why_sensitive": "This parameter can change based on the user's explicit preferences, constraints, budget, privacy stance, language, risk tolerance, schedule, accessibility needs, or communication style."
      }
    ]
  },
  "NoRelation": 1
}
