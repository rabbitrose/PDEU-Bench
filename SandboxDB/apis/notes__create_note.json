    "function": "notes.create_note",
    "version": "1.0",
    "input_format": "json_object",
    "output_format": "json_object",
    "parameters": [
      {
        "name": "title",
        "type": "string",
        "required": true,
        "description": "Note title.",
        "preference_sensitive": false
      },
      {
        "name": "body",
        "type": "string",
        "required": true,
        "description": "Note body.",
        "preference_sensitive": false
      },
      {
        "name": "tags",
        "type": "array[string]",
        "required": true,
        "description": "Tags.",
        "preference_sensitive": false
      },
      {
        "name": "linked_entities",
        "type": "array[string]",
        "required": false,
