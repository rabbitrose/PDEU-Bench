{
  "api_name": "contacts.search",
  "category": "contacts",
  "action": "search",
  "description": "Search contacts by name, role, organization, relationship, or location.",
  "interface": {
    "type": "function_call",
    "function": "contacts.search",
    "version": "1.0",
    "input_format": "json_object",
    "output_format": "json_object",
    "parameters": [
      {
        "name": "query",
        "type": "string",
        "required": true,
        "description": "Contact search query.",
        "preference_sensitive": false
      },
      {
        "name": "relationship_type",
        "type": "string",
        "required": false,
        "description": "work, family, friend, vendor, clinician, advisor, or other.",
        "preference_sensitive": false
      },
      {
        "name": "organization",
        "type": "string",
        "required": false,
        "description": "Organization filter.",
        "preference_sensitive": false
      },
      {
        "name": "location",
        "type": "string",
        "required": false,
        "description": "Location filter.",
        "preference_sensitive": true
      },
      {
        "name": "privacy_mode",
        "type": "string",
        "required": false,
        "description": "Controls how much contact detail can be returned.",
        "preference_sensitive": false
      },
      {
        "name": "max_results",
        "type": "integer",
        "required": false,
        "description": "Maximum result count.",
        "preference_sensitive": false
      }
    ],
    "returns": {
      "contacts": "array",
      "match_quality": "string",
      "redactions": "array"
    },
    "preference_sensitive_parameters": [
      "location"
    ],
    "preference_sensitive_parameter_details": [
      {
        "name": "location",
        "type": "string",
        "why_sensitive": "This parameter can change based on the user's explicit preferences, constraints, budget, privacy stance, language, risk tolerance, schedule, accessibility needs, or communication style."
      }
    ]
  },
  "NoRelation": 1
}
