{
  "api_name": "documents.search",
  "category": "documents",
  "action": "search",
  "description": "Search files, notes, PDFs, images, and documents by keyword, metadata, owner, or task context.",
  "interface": {
    "type": "function_call",
    "function": "documents.search",
    "version": "1.0",
    "input_format": "json_object",
    "output_format": "json_object",
    "parameters": [
      {
        "name": "query",
        "type": "string",
        "required": true,
        "description": "Search query.",
        "preference_sensitive": false
      },
      {
        "name": "file_types",
        "type": "array[string]",
        "required": false,
        "description": "File type filters.",
        "preference_sensitive": false
      },
      {
        "name": "date_start",
        "type": "date",
        "required": false,
        "description": "Earliest modified or created date.",
        "preference_sensitive": false
      },
      {
        "name": "date_end",
        "type": "date",
        "required": false,
        "description": "Latest modified or created date.",
        "preference_sensitive": false
      },
      {
        "name": "owner_filter",
        "type": "string",
        "required": false,
        "description": "Owner or shared source.",
        "preference_sensitive": false
      },
      {
        "name": "folder_hints",
        "type": "array[string]",
        "required": true,
        "description": "Likely folders.",
        "preference_sensitive": false
      },
      {
        "name": "privacy_mode",
        "type": "string",
        "required": false,
        "description": "Controls redaction of sensitive filenames or snippets.",
        "preference_sensitive": true
      },
      {
        "name": "max_results",
        "type": "integer",
        "required": false,
        "description": "Maximum result count.",
        "preference_sensitive": false
      }
    ],
    "returns": {
      "documents": "array",
      "top_matches": "array",
      "redactions": "array"
    },
    "preference_sensitive_parameters": [
      "privacy_mode"
    ],
    "preference_sensitive_parameter_details": [
      {
        "name": "privacy_mode",
        "type": "string",
        "why_sensitive": "This parameter can change based on the user's explicit preferences, constraints, budget, privacy stance, language, risk tolerance, schedule, accessibility needs, or communication style."
      }
    ]
  },
  "NoRelation": 1
}
